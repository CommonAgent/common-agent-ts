{
  "name": "@common-agent/reputations",
  "version": "0.1.0",
  "description": "Reference implementation of Agent Reputations: the scoring formula, the pool, signed reports and their verification, the heads commitment, and NDA breach claims.",
  "keywords": [
    "common-agent",
    "agent-reputations",
    "reputation",
    "scoring"
  ],
  "homepage": "https://agentreputations.com",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CommonAgent/common-agent-ts.git",
    "directory": "packages/reputations"
  },
  "bugs": {
    "url": "https://github.com/CommonAgent/common-agent-ts/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./ports": {
      "types": "./dist/ports.d.ts",
      "default": "./dist/ports.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE",
    "LICENSE-UNICODE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20.10"
  },
  "dependencies": {
    "@common-agent/crypto": "0.1.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "publishConfig": {
    "access": "public"
  }
}
