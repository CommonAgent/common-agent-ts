      "agents": [
        "ledger.harborandline@example.com"
      ],
      "grants": [
        "messages",
        "share"
      ],
      "per_hour": 10,
      "grade": "enforced"
    },
    "cases": [
      {
        "name": "plain_message",
        "from": "provider",
        "to": "ledger.harborandline@example.com",
        "carries": "text",
        "expected": "delivered"
      },
      {
        "name": "attachment",
        "from": "provider",
        "to": "ledger.harborandline@example.com",
        "carries": "attachment",
        "expected": "delivered"
